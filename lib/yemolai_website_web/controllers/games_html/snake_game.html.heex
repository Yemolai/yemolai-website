<style>
  #game-container {
   padding: 0.4em;
   border-radius: 0.25em;
   width: calc(100vw - 6em);
   height: calc(100vh - 8em);
   background-color: #F9F9F9;
  }
  canvas#game-board {
   width: 100%;
   height: calc(100% - 1.2em);
  }
  .info-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }
  .d-pad {
    display: none;
  }
  .input-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @media (max-width: 768px) {
    #game-container {
      width: calc(100vw - 4em);
      height: calc(45vh - 2em);
    }
    .d-pad {
        margin-top: 1em;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 1fr);
        gap: 10px;
        width: 300px;
        height: 300px;
    }

    .d-pad-button {
        font-size: 24px;
        border: none;
        background-color: #4a4a4a;
        color: white;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .d-pad-button:hover {
        background-color: #666666;
    }

    .d-pad-button:active {
        background-color: #333333;
    }

    .up {
        grid-column: 2;
        grid-row: 1;
        border-radius: 10px 10px 0 0;
    }

    .left {
        grid-column: 1;
        grid-row: 2;
        border-radius: 10px 0 0 10px;
    }

    .center {
        grid-column: 2;
        grid-row: 2;
        border-radius: 50%;
        font-size: 36px;
    }

    .right {
        grid-column: 3;
        grid-row: 2;
        border-radius: 0 10px 10px 0;
    }

    .down {
        grid-column: 2;
        grid-row: 3;
        border-radius: 0 0 10px 10px;
    }

    .escape {
       grid-column: 1;
       grid-row: 1;
       border-radius: 10px 0 0 0;
       width: 60%;
       height: 60%;
       font-size: 0.8em;
    }
  }
  @media (max-width: 640px) {
    #game-container {
      width: calc(100vw - 2em);
    }
  }
</style>
<div id="game-container">
  <canvas id="game-board"></canvas>
  <div class="info-row">
    <p><small><strong>Score:</strong>&nbsp;<span id="game-points">0</span></small></p>
    <p><small>Esc to pause</small></p>
    <p><small><strong>Highest:</strong>&nbsp;<span id="game-record">0</span></small></p>
  </div>
  <div class="input-container">
    <div class="d-pad">
      <button class="d-pad-button escape" onclick="window.snakeGameControls.input('Escape', true)">
        Esc
      </button>
      <button class="d-pad-button up" onclick="window.snakeGameControls.input('ArrowUp')">
        ↑
      </button>
      <button class="d-pad-button left" onclick="window.snakeGameControls.input('ArrowLeft')">
        ←
      </button>
      <button class="d-pad-button center" onclick="window.snakeGameControls.input('Space', true)">
        ␣
      </button>
      <button class="d-pad-button right" onclick="window.snakeGameControls.input('ArrowRight')">
        →
      </button>
      <button class="d-pad-button down" onclick="window.snakeGameControls.input('ArrowDown')">
        ↓
      </button>
    </div>
  </div>
</div>

<script src={~p"/assets/snake_game.js"}>
</script>
<script type="text/javascript">
  window.snakeGameControls.init();
</script>
